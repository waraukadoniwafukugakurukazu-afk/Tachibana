{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tachibana-festival",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tachibana-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES"
    }
  ]
}